# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
atomboy-*.tar

# Temporary files, for example, from tests.
/tmp/

# Corpus de vecteurs SingleStepTests — récupéré par `mix atomboy.corpus`
/test/fixtures/
# Les parties de jeu : personnelles, changeantes — pas dans l'historique.
*.sav
*.state
*.gb
*.gbc

burrito_out/
atomboy-crash.log
erl_crash.dump
atomboy_mac
atomboy_mac.tar
__pycache__/
.claude/
.DS_Store

# ESP-IDF build output and the config it generates from sdkconfig.defaults.
esp32/native/build/
esp32/native/sdkconfig
esp32/native/sdkconfig.old
dependencies.lock
esp32/native/main/blob.bin
esp32/native/sdkconfig*

# clangd's index, written by the editor rather than by the build.
esp32/native/.cache/
/.superpowers/
