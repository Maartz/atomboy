#!/bin/sh
# The Game Boy in the terminal.
#
# -noinput switches off the BEAM's own tty reader (prim_tty), which otherwise
# reads the terminal non-stop and steals one byte in three from the game's
# keyboard — fatal to arrow sequences. Measured by scripts/probe_clavier2.exs:
# 0/301 bytes received without -noinput, 301/301 with it.
exec env ELIXIR_ERL_OPTIONS="-noinput $ELIXIR_ERL_OPTIONS" mix atomboy.play "$@"
