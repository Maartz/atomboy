#!/bin/sh
# La Game Boy dans le terminal.
#
# -noinput éteint le lecteur interne du BEAM (prim_tty), qui sinon lit le
# terminal en permanence et vole un octet sur trois au clavier du jeu —
# fatal aux séquences de flèches. Mesuré par scripts/probe_clavier2.exs :
# 0/301 octets reçus sans -noinput, 301/301 avec.
exec env ELIXIR_ERL_OPTIONS="-noinput $ELIXIR_ERL_OPTIONS" mix atomboy.play "$@"
