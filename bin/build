#!/bin/sh
# The atomboy executables, built in one command.
#
#     bin/build              tests, then binaries in burrito_out/
#     bin/build --fast       skip the tests
#     bin/build --install    + copy to ~/.local/bin/atomboy
#     bin/build --app        + Atomboy.app (native SwiftUI shell)
#     bin/build --release    + Developer ID signing, notarization, a zip
#                              that runs on any Mac (implies --app)
#     bin/build --clean      purge the extraction caches (close the game first!)
#
# Under the hood: Burrito requires zig 0.16.0 (mise installs it if needed),
# the release is built in prod, and the stale extraction caches
# (~/Library/Application Support/.burrito/atomboy_*) are purged — the
# version carries the commit SHA, every build has its own key, so the old
# ones are of no further use.
set -e
cd "$(dirname "$0")/.."

ZIG=zig@0.16.0
fast=false
install=false
clean=false
app=false
release=false
for arg in "$@"; do
  case "$arg" in
    --vite|--fast) fast=true ;;
    --install) install=true ;;
    --menage|--clean) clean=true ;;
    --app) app=true ;;
    --release) app=true; release=true ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

command -v xz > /dev/null || { echo "xz missing (brew install xz)" >&2; exit 1; }
mise which zig --tool-version "$ZIG" > /dev/null 2>&1 || mise install "$ZIG"

if ! $fast; then
  echo "── tests ──"
  mix test
fi

echo "── release ──"
# Burrito suffixes ("atomboy_macos_arm 2") instead of overwriting: clean slate.
rm -rf burrito_out
MIX_ENV=prod mise exec "$ZIG" -- mix release --overwrite

if $clean; then
  # Never by default: purging the cache of a RUNNING game tears its files
  # away from the BEAM — modules not found, unreadable crash (learned the
  # hard way).
  echo "── clean ──"
  rm -rf "$HOME/Library/Application Support/.burrito/atomboy_"*
  echo "extraction caches purged (they come back on the next launch)"
fi

if $app; then
  # The macOS .app: the SwiftUI shell (rel/macos/Atomboy.swift plus
  # rel/macos/Shell.swift, the drawn console body) up front, the Burrito
  # binary as the `--serveur` engine behind it. Ad hoc signature —
  # mandatory on Apple Silicon, and enough locally.
  echo "── Atomboy.app ──"
  version=$(mix run --no-start -e 'IO.write(Atomboy.MixProject.project()[:version])' 2>/dev/null | tail -1)
  # Assembled and signed in /tmp: under a synced folder (iCloud Documents…),
  # the file provider keeps restamping xattrs and codesign refuses
  # ("detritus") — so out of its reach, then moved.
  content=/tmp/Atomboy.app/Contents
  rm -rf /tmp/Atomboy.app burrito_out/Atomboy.app
  mkdir -p "$content/MacOS" "$content/Resources"
  # "atomboy-moteur", not "atomboy": APFS is case-insensitive — "atomboy"
  # would clobber the "Atomboy" shell (learned the hard way). The name is
  # baked into rel/macos/Atomboy.swift too.
  cp burrito_out/atomboy_macos_arm "$content/MacOS/atomboy-moteur"
  swiftc -O -parse-as-library -target arm64-apple-macos14.0 -o "$content/MacOS/Atomboy" rel/macos/Atomboy.swift rel/macos/Shell.swift 2> /dev/null
  python3 rel/macos/icon.py "$content/Resources/Atomboy.icns"
  sed "s/VERSION_ATOMBOY/$version/g" rel/macos/Info.plist > "$content/Info.plist"
  xattr -cr /tmp/Atomboy.app
  codesign --force --deep --sign - /tmp/Atomboy.app 2> /dev/null
  mv /tmp/Atomboy.app burrito_out/Atomboy.app
  echo "  burrito_out/Atomboy.app (drag it into /Applications)"
fi

if $release; then
  # The app that leaves this Mac: Developer ID, hardened runtime (with the
  # JIT entitlements a BEAM cannot live without), notarized and stapled.
  # One-time setup for the notary profile:
  #     xcrun notarytool store-credentials atomboy \
  #         --apple-id you@example.com --team-id TEAMID
  # (with an app-specific password from appleid.apple.com).
  echo "── release ──"
  identity="${ATOMBOY_SIGN_ID:-$(security find-identity -v -p codesigning \
    | grep -m1 "Developer ID Application" | sed 's/.*"\(.*\)"/\1/')}"
  [ -n "$identity" ] || { echo "no Developer ID Application identity in the keychain" >&2; exit 1; }
  profile="${ATOMBOY_NOTARY_PROFILE:-atomboy}"
  echo "  signing as: $identity"

  # Like the assembly above, the signing happens OUT of the synced folder:
  # the file provider restamps xattrs on anything under Documents, and
  # codesign calls that detritus and refuses.
  bundle=/tmp/Atomboy-release.app
  rm -rf "$bundle"
  cp -R burrito_out/Atomboy.app "$bundle"
  xattr -cr "$bundle"

  ent=rel/macos/Entitlements.plist
  # Inner binary first, then the bundle — --deep is the deprecated shortcut
  # that signs in the wrong order.
  codesign --force --options runtime --entitlements "$ent" --sign "$identity" \
    "$bundle/Contents/MacOS/atomboy-moteur"
  codesign --force --options runtime --entitlements "$ent" --sign "$identity" "$bundle"
  codesign --verify --strict "$bundle"

  echo "  notarizing (this talks to Apple; a few minutes)…"
  rm -f /tmp/Atomboy-release.zip
  ditto -c -k --keepParent "$bundle" /tmp/Atomboy-release.zip
  if ! xcrun notarytool submit /tmp/Atomboy-release.zip \
      --keychain-profile "$profile" --wait; then
    echo "notarization failed — if the profile '$profile' does not exist yet:" >&2
    echo "    xcrun notarytool store-credentials $profile --apple-id … --team-id …" >&2
    exit 1
  fi
  xcrun stapler staple "$bundle"
  rm -f /tmp/Atomboy-release.zip burrito_out/Atomboy.zip
  ditto -c -k --keepParent "$bundle" burrito_out/Atomboy.zip
  rm -rf burrito_out/Atomboy.app
  mv "$bundle" burrito_out/Atomboy.app
  echo "  burrito_out/Atomboy.zip — AirDrop it to any Mac; it double-clicks clean"
fi

echo "── binaries ──"
ls -lh burrito_out/ | awk 'NR > 1 {print "  " $NF " (" $5 ")"}'

if $install; then
  mkdir -p "$HOME/.local/bin"
  cp burrito_out/atomboy_macos_arm "$HOME/.local/bin/atomboy"
  echo "installed: ~/.local/bin/atomboy"
fi
